# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Read-Only Neo4j Credentials for Text-to-Cypher Execution (Optional; falls back to NEO4J_USER)
NEO4J_READONLY_USER=neo4j
NEO4J_READONLY_PASSWORD=password123

# Primary LLM Settings (Qwen3-8B via Ollama or OpenAI-compatible local server)
LLM_PROVIDER=ollama_openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-no-key-required
LLM_MODEL_NAME=qwen3:8b
LLM_Fallback_MODEL_NAME=qwen3:4b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Content Classifier Settings
CLASSIFIER_MODE=heuristic_or_pretrained
CLASSIFIER_MODEL_NAME=cardiffnlp/twitter-roberta-base-hate-multiclass-latest
CLASSIFIER_DEVICE=cpu

# Optional X API Settings (Not required for baseline or public datasets)
X_API_BEARER_TOKEN=